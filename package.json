{
  "name": "miniclaw",
  "version": "0.1.0",
  "description": "A teaching-scale multi-channel AI gateway",
  "type": "module",
  "bin": {
    "miniclaw": "miniclaw.mjs"
  },
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "format": "oxfmt -w .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "miniclaw": "node miniclaw.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "latest",
    "oxfmt": "^0.1.0",
    "oxlint": "^1.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "kysely": "^0.29.5",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  }
}
